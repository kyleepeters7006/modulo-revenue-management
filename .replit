modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["geos", "glibcLocales", "libGL", "libGLU", "jq"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "comp-position-refdata-parity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "al-mc-family-matching"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "inhouse-rate-planning"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "inhouse-rate-planning-live"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ai-suggestion-impact-parity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ai-suggestion-gates"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ai-router-fallback"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cancellable-write"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "inhouse-rate-plan-export"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "comp-position-refdata-parity"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx tests/compPositionRefDataParity.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "al-mc-family-matching"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx tests/alMcFamilyMatching.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "inhouse-rate-planning"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx tests/inhouseRatePlanning.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "inhouse-rate-planning-live"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx tests/inhouseRatePlanningLive.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "ai-suggestion-impact-parity"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx tests/aiSuggestionImpactParity.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "ai-suggestion-gates"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx tests/aiSuggestionGates.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "ai-router-fallback"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx tests/aiRouterFallback.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "cancellable-write"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx tests/cancellableWrite.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "inhouse-rate-plan-export"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx tests/inhouseRatePlanExport.test.ts"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
integrations = ["javascript_gemini:1.0.0", "javascript_database:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_object_storage:1.0.0", "javascript_openai:1.0.0", "javascript_openai_ai_integrations:1.0.0", "github:1.0.0", "javascript_anthropic_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[userenv]

[userenv.development]
